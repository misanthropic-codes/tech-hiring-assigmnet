# Optional: pin a delivery location (defaults to Bengaluru Whitefield area)
ZEPTO_LAT=12.96902
ZEPTO_LNG=77.75395

# Path to Playwright storage state after interactive login (OTP)
ZEPTO_STORAGE_STATE=storage_state.json

# Headless is flaky vs AWS WAF; prefer headed Chrome for live runs
ZEPTO_HEADED=1